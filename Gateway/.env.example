# ==============================================================================
# Smart Workstation - Raspberry Pi Gateway Configuration
# Course: 2110356 Embedded System (CEDT)
# ==============================================================================

# Hardware Simulation Mode (Set to 1 or true to test without physical GPIO / I2C)
MOCK_HARDWARE=0

# ------------------------------------------------------------------------------
# MQTT Broker Settings
# ------------------------------------------------------------------------------
# Default: Cloud broker (broker.emqx.io) matching ESP32 nodes & React dashboard.
# For fully offline local operation, set to: localhost (with Mosquitto on Pi)
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# Firebase Firestore Cloud Storage (Requirement M5 & E5)
# ------------------------------------------------------------------------------
# Path to the downloaded service account private key JSON
# Keep this file OUTSIDE git (e.g., in ~/secrets/ or local Gateway/ folder ignored by git)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIRESTORE_COLLECTION=telemetry
CLOUD_PERIOD_S=5

# ------------------------------------------------------------------------------
# Alert Notifications (Requirement M6)
# ------------------------------------------------------------------------------
# Discord Webhook URL (Channel Settings > Integrations > Webhooks > Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# LINE Messaging API (LINE Developers Console > Messaging API Channel)
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here
LINE_TO_USER_ID=your_target_user_or_group_id_here
ALERT_COOLDOWN_S=300
