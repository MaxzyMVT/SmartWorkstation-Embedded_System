# ==============================================================================
# Smart Workstation - React Web Interface Configuration
# ==============================================================================

# Option A: Firebase Cloud Firestore (Direct In-Web Live Telemetry)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIRESTORE_COLLECTION=telemetry

# Option B: MQTT Cloud WebSockets (Alternative direct MQTT stream)
VITE_MQTT_BROKER_URL=ws://localhost:9001
VITE_MQTT_TOPIC=smart_workstation/telemetry
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
